# ── Postgres (Supabase / Neon / Railway) ──────────────────────────────────────
# Supabase: Settings → Database → Connection string → URI (transaction pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"

# Supabase: Settings → Database → Connection string → URI (direct connection)
# Required for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Redis (Upstash) ────────────────────────────────────────────────────────────
# Upstash Console → Your Database → REST API
UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# ── App URL ────────────────────────────────────────────────────────────────────
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Cron secret ────────────────────────────────────────────────────────────────
# Any random string — used to authenticate Vercel Cron calls
CRON_SECRET="your-random-secret-here"
